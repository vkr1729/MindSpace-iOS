# MindSpace Git Ignore

# Strictly exclude 15.81 GB local media library
Content/
MindSpaceLibrary/

# Build and Derived Data
build/
DerivedData/
*.xcodeproj
*.xcworkspace
.DS_Store

# Temporary payloads and archives (dist is tracked for direct downloads)
Payload/
*.zip

# Never commit binaries: IPAs are built by CI and uploaded as artifacts.
# Existing tracked IPAs stay in history; all future ones are ignored.
*.ipa
*.ipa.sha256

# Temporary test artifacts
*.tmp
*.log
.commandcode/
